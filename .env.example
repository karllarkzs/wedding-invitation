# ─── Google Sheets (RSVP storage) ──────────────────────────────────────────
# From the service account JSON key file ("client_email").
GOOGLE_SERVICE_ACCOUNT_EMAIL=rsvp-writer@your-project-id.iam.gserviceaccount.com

# From the same JSON file ("private_key"). Keep the quotes and the literal \n
# sequences exactly as they appear in the JSON; the app converts them.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...your key...\n-----END PRIVATE KEY-----\n"

# The long ID in your sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789

# ─── Admin page (/admin) ───────────────────────────────────────────────────
ADMIN_PASSWORD=choose-a-long-private-password
# Optional: a separate random secret for signing admin sessions.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ─── Optional ──────────────────────────────────────────────────────────────
# Your site's address, e.g. https://karl-and-hannah.netlify.app or a custom domain.
# Used for link-preview images and the personal links copied in /admin.
# Set it on Netlify. (If left empty, Netlify's or Vercel's main address is used.)
NEXT_PUBLIC_SITE_URL=
